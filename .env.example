# Example/local documentation only. Never commit a real TMDB API key.
TMDB_API_KEY=replace-with-your-tmdb-v3-api-key

# Optional overrides for movie/TV embeds only; anime uses the three fixed
# providers adapted from Anistream's HTML.
VIDRIFT_MOVIE_BASE_URL=https://embed.vidrift.net/embed/movie
VIDRIFT_TV_BASE_URL=https://embed.vidrift.net/embed/tv
